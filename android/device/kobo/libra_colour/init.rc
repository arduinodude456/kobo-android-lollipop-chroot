# Dedicated chroot init: imported generated env contains the release BOOTCLASSPATH.
# NO stock init.rc, init.usb.rc, ueventd, SELinux, sysfs, powerctl or fstab imports.
import /init.environ.rc

on early-init
    mkdir /dev/socket 0755 root root
    mkdir /dev/pts 0755 root root
    mkdir /dev/kobo 0770 system graphics
    mkdir /dev/input 0755 root root

on init
    export LD_PRELOAD /system/lib/libkobofb.so
    export KOBO_FB_WIDTH 600
    export KOBO_FB_HEIGHT 800
    export KOBO_FB_FORMAT RGB565
    export KOBO_FB_FILE /dev/kobo/fb.bin
    export KOBO_FB_META /dev/kobo/fb.meta
    export KOBO_BINDER_LOG /data/local/tmp/kobo-binder.log
    symlink /system/etc /etc
    symlink /system/bin /bin
    symlink /data/local/tmp /tmp
    mkdir /mnt 0755 root system
    mkdir /mnt/asec 0700 root system
    mkdir /mnt/obb 0700 root system
    mkdir /storage 0755 root root
    mkdir /storage/emulated 0755 root root
    mkdir /storage/emulated/0 0775 media_rw media_rw
    symlink /storage/emulated/0 /sdcard
    mkdir /cache 0770 system cache
    mkdir /data 0771 system system
    mkdir /data/system 0775 system system
    mkdir /data/system/users 0775 system system
    mkdir /data/system/users/0 0775 system system
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0700 keystore keystore
    mkdir /data/misc/keychain 0771 system system
    mkdir /data/misc/systemkeys 0700 system system
    mkdir /data/misc/media 0700 media media
    mkdir /data/data 0771 system system
    mkdir /data/app 0771 system system
    mkdir /data/app-private 0771 system system
    mkdir /data/app-lib 0771 system system
    mkdir /data/app-asec 0700 root root
    mkdir /data/dalvik-cache 0771 system system
    mkdir /data/resource-cache 0771 system system
    mkdir /data/property 0700 root root
    mkdir /data/local 0751 root root
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/drm 0770 drm drm
    mkdir /data/mediadrm 0770 mediadrm mediadrm
    mkdir /data/security 0711 system system
    chmod 0666 /dev/binder
    chmod 0666 /dev/ashmem
    chmod 0666 /dev/alarm
    setprop ro.hardware kobo_libra_colour
    setprop ro.bootmode unknown
    setprop ro.factorytest 0
    setprop ro.crypto.state unencrypted
    setprop vold.decrypt trigger_restart_framework
    # KitKat's system_server instantiates its own SurfaceFlinger unless told not to;
    # that would collide with the surfaceflinger service below and leave no display.
    setprop system_init.startsurfaceflinger 0
    setprop debug.sf.nohwcomposer 1
    setprop persist.sys.usb.config none

on post-fs-data
    load_persist_props

on boot
    class_start core
    class_start main

service servicemanager /system/bin/servicemanager
    class core
    user system
    group system
    onrestart restart surfaceflinger
    onrestart restart zygote
    onrestart restart media

service surfaceflinger /system/bin/surfaceflinger
    class main
    user system
    group graphics drmrpc
    onrestart restart zygote

# Dummy audio HAL satisfies old framework clients; no Kobo audio device is shared.
service media /system/bin/mediaserver
    class main
    user media
    group audio camera inet net_bt net_bt_admin net_bw_acct drmrpc mediadrm

# KitKat/Lollipop system_server blocks in NetworkManagementService until netd's socket exists.
service netd /system/bin/netd
    class main
    socket netd stream 0660 root system
    socket dnsproxyd stream 0660 root inet
    socket mdns stream 0660 root system

service installd /system/bin/installd
    class core
    socket installd stream 0600 system system

service keystore /system/bin/keystore /data/misc/keystore
    class main
    user keystore
    group keystore drmrpc

service zygote /system/bin/app_process -Xzygote /system/bin --zygote --start-system-server
    class main
    socket zygote stream 0660 root system

# No critical-service reboot actions and no sys.powerctl trigger. Container
# lifecycle belongs to the Kobo supervisor, not Android's global reboot API.
